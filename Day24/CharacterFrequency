public class CharacterFrequency{
    public static void main(String[] args) {
        String str="programming";
        char ch[]=str.toCharArray();
        
        for(int i=0;i<ch.length;i++){
            int count=1;
            for(int j=i+1;j<ch.length;j++){
                if(ch[i]==ch[j]){
                    count++;
                    ch[j]='O';
                }
            }
            if(ch[i]!='O'){
                System.out.println(ch[i]+ " : "+count);
            }
        }
    }
}
