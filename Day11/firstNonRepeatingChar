public class firstNonRepeatingChar {
    public static void main(String[] args) {
        String s="geeksforgeeks";
        int n = s.length();
        for (int i = 0; i < n; ++i) {
            boolean found = false;

            for (int j = 0; j < n; j++) {    //++j
                if (i != j && s.charAt(i) == s.charAt(j)) {
                    found = true;
                    break;
                }
            }
            if (!found) {

                System.out.println(s.charAt(i)); 
                break;
            }
        }

    
    }
}
