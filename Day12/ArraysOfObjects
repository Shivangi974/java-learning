class Students{
    public int roll;
    public String name;

    Students(int roll,String name){
        this.roll=roll;
        this.name=name;
    }
}
public class ArraysOfObjects {
    public static void main(String[] args) {
        Students arr[];
        arr=new Students[5];

        //initialize elements of array
        arr[0]=new Students(1, "Ruchi");
        arr[1]=new Students(2, "Shivangi");
        arr[2]=new Students(3, "Goli");
        arr[3]=new Students(4, "Goldi");
        arr[4]=new Students(5, "Goldin");

        //accesing
        for(int i=0;i<arr.length;i++){
            System.out.println("Elements at "+ i + ": { "+ arr[i].roll + " " + arr[i].name +" } ");
        }
    }
}
