public class Arrays {
    public static void main(String[] args) {
        //declare array
        // int arr[]=new int[5];

        //initialize array
        int arr[]={10,20,30,40,50};

        // size of an array
        int n=arr.length;
        
        
        // Traversing  array
        System.out.print("Primitive Array : " +"\t");
        for(int i=0;i<arr.length;i++){
            System.out.print(arr[i] + "\t");
        }
        System.out.println();

        //Acessing element of an array
        System.out.println("1st element of an array is : "+ arr[0]);
        
        //update elements of an array
        arr[0]=80;
        System.out.println("after changing 1st elemt of an array is :"+ arr[0]);   


        

        // non-primitive datatype array
        System.out.print("Non-Primitive Array : "+"\t");
        String []strArr={"Ruchi","Shivangi","Aarav","Pihu","Shristi","Aastha"};
        
        //Traversing array.
        for(int i=0;i<strArr.length;i++){
            System.out.print(strArr[i] + "\t");
        }
        System.out.println();
    }
}
