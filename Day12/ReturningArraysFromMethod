public class ReturningArraysFromMethod {
    public static void main(String[] args) {
        int arr[]=m1();
        for(int i=0;i<arr.length;i++){
            System.out.println(arr[i] + " ");
        }
    }
    public static int[] m1(){
        //returning array 
        //method 1: 
        // return new int [] {1,2,3};

        //method 2:
        int arr[]={1,2,3};
        return arr;
    }
}
