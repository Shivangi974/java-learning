public class DiamondStarPattern {
    public static void main(String[] args) {
        int n=7;
        for(int i=0;i<n;i++){
            // for spaces 
            for(int j=0;j<n-i;j++){
                System.out.print("  ");
            }
            //for star
            for(int k=0;k<2*i-1;k++){
                System.out.print("* ");
            }
            System.out.println();
        }

        //lower triangle
        for (int i = n-1; i >= 1; i--) {
            //for spaces
            for(int j=0;j<n-i;j++){
                System.out.print("  ");
            }

            //for star
            for(int k=0;k< 2*i-1;k++){
                System.out.print("* ");
            }
            System.out.println();
        }
    }
}
